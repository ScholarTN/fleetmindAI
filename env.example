# ─── Database ───────────────────────────────────────────────
POSTGRES_USER=fleetmind
POSTGRES_PASSWORD=fleetmind_dev
POSTGRES_DB=fleetmind

# ─── Backend ─────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string_in_production
ENVIRONMENT=development

# ─── AI Provider (switch between openai and ollama) ──────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here

# For local AI with Ollama (no API key needed)
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ─── Frontend ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
